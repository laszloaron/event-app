{
  "name": "eventmap-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:api && tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:api": "openapi-typescript openapi.json --root-types --root-types-no-schema-prefix -o src/api/schema.d.ts",
    "check:api": "openapi-typescript openapi.json --root-types --root-types-no-schema-prefix -o src/api/schema.d.ts --check"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
