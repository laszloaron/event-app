# Copy to .env (scripts/start.* does this automatically). Dev defaults only - change them for any shared deployment.
POSTGRES_DB=eventmap
POSTGRES_USER=eventmap
POSTGRES_PASSWORD=eventmap-dev-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
DJANGO_DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost

LOG_LEVEL=INFO
